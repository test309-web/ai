[Unit]
Description=SoftAtlas AI Gateway
After=network.target ollama.service
[Service]
User=ubuntu
WorkingDirectory=/opt/softatlas-gateway
EnvironmentFile=/etc/softatlas-gateway.env
ExecStart=/opt/softatlas-gateway/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
[Install]
WantedBy=multi-user.target
